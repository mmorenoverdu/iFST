        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="clicked = mouse.getPressed()[0]&amp;#10;&amp;#10;if clicked:&amp;#10;    if mouse.isPressedIn(left_poly):&amp;#10;        handedness = &quot;left&quot;&amp;#10;        continueRoutine = False&amp;#10;    elif mouse.isPressedIn(right_poly):&amp;#10;        handedness = &quot;right&quot;&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="clicked = mouse.getPressed()[0];&amp;#10;if (clicked) {&amp;#10;    if (mouse.isPressedIn(left_poly)) {&amp;#10;        handedness = &quot;left&quot;;&amp;#10;        continueRoutine = false;&amp;#10;    } else {&amp;#10;        if (mouse.isPressedIn(right_poly)) {&amp;#10;            handedness = &quot;right&quot;;&amp;#10;            continueRoutine = false;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
