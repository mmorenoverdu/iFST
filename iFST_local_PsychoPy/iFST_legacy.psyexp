        <Param val="$'Number of taps: ' + str(n_taps) + '\nNumber of spaces: ' + str(n_spaces) + '\nNumber of errors: ' + str(n_errors) + '\nAverage error distance (% screen): ' + str(mean_error) + '\n\nAverage tap-space time (ms): ' + str(mean_diff) + '\n\nTrial duration (s):\nTaps: ' + str(tap_duration) + '\nSpaces: ' + str(space_duration)" valType="str" updates="set every repeat" name="text"/>
