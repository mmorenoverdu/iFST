        <Param val="import {prefs} from 'psychopy';&amp;#10;prefs.hardware[&quot;audioDevice&quot;] = &quot;Haut-parleur (Realtek(R) Audio)&quot;;&amp;#10;prefs.hardware[&quot;audioLib&quot;] = [&quot;ptb&quot;];&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
