  <Flow>
    <CounterbalanceRoutine name="counterbalance"/>
    <Routine name="exp_settings"/>
    <LoopInitiator loopType="TrialHandler" name="lang_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'language': 'English', 'ISO_code': 'EN'}, {'language': 'Spanish', 'ISO_code': 'ES'}, {'language': 'French', 'ISO_code': 'FR'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="language_localiser.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="lang_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="load_lg"/>
    <LoopTerminator name="lang_loop"/>
    <LoopInitiator loopType="TrialHandler" name="messages_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'message': 'title_msg', 'EN': 'Imagined Finger Sequence Task\n(iFST)', 'ES': 'Tarea de Secuencia de Dedos Imaginada\n(TSDi)', 'FR': 'x'}, {'message': 'welcome_msg', 'EN': 'Welcome to the task!\n\nThe goal of this task is to assess your ability to imagine finger movements.', 'ES': 'Bienvenido/a a la tarea!\n\nEl objetivo de esta tarea es valorar tu capacidad para imaginar movimientos con los dedos.', 'FR': 'x'}, {'message': 'adv_msg', 'EN': 'Press SPACE to continue', 'ES': 'Presiona ESPACIO para continuar', 'FR': 'x'}, {'message': 'bye_msg', 'EN': 'You have finished the experiment\n\nThank you very much for taking part!\n\nThe experiment will close in 3 seconds', 'ES': 'Has terminado el experimento\n\nGracias por participar!\n\nEl experimento se cerrará en 3 segundos', 'FR': 'x'}, {'message': 'correct_msg', 'EN': 'Correct', 'ES': 'Correcto', 'FR': 'x'}, {'message': 'incorrect_msg', 'EN': 'Incorrect', 'ES': 'Incorrecto', 'FR': 'x'}, {'message': 'time_msg', 'EN': 'Time', 'ES': 'Tiempo', 'FR': 'x'}, {'message': 'seconds_msg', 'EN': 'seconds', 'ES': 'seconds', 'FR': 'x'}, {'message': 'block_first_msg', 'EN': 'You are going to start the practice part.\n\nThe goal is to type the sequences correctly, and familiarise with the difference between execution and imagery.\n\nAt this stage, it is critical that you respond correctly as indicated.\n\nYou will not progress to the next part until you respond correctly to all sequences in both execution and imagery.', 'ES': 'Vas a empezar la parte de práctica.\n\nEl objetivo es escribir las secuencias correctamente, y familiarizarte con la diferencia entre ejecución e imaginación.\n\nEn este punto, es fundamental que responsas correctamente como se indica.\n\nNo avanzarás a la siguiente parte hasta que hayas respondido correctamente a todas las secuencias tanto en ejecución como imaginación.', 'FR': 'x'}, {'message': 'block_intro_task_msg', 'EN': 'Now that you have practiced, you will go through the task itself.\n\nRemember your FIRST PRIORITY is to respond ACCURATELY.\n\nYour SECOND PRIORITY is to complete the sequence as QUICKLY AS POSSIBLE.\n\nIn this part, you will not have feedback on your performance, but you will not you have finished a trial because the screen will change.', 'ES': 'Ahora que has practicado, vas a hacer la tarea como tal.\n\nRecuerda que tu PRIMERA PRIORIDAD es responder de manera CORRECTA.\n\nTu SEGUNDA PRIORIDAD es completar la secuencia LO MÁS RÁPIDO POSIBLE.\n\nEn esta parte, no tendrás feedback. No habrás finalizado el trial hasta que no veas que la pantalla cambia.', 'FR': 'x'}, {'message': 'block_msg_half', 'EN': 'You are halfway through the task.\n\nPlease, have a break of at least 1 minute.\n\nThe task will resume automatically after 2 minutes.', 'ES': 'Vas por la mitad de la tarea.\n\nPor favor, tómate un descanso de al menos 1 minuto.\n\nLa tarea procederá automáticamente a los 2 minutos.', 'FR': 'x'}, {'message': 'block_msg_standard', 'EN': 'You have finished the block.\n\nTake a moment to have a break before proceeding.\n\nThe task will resume automatically after 1 minute.\n\nYou may proceed before if you want. Wait for a message to appear below.', 'ES': 'Has terminado el bloque.\n\nTómate un momento para descansar.\n\nLa tarea procederá automáticamente en 1 minuto.\n\nPuedes continuar antes si lo deseas. Espera a que aparezca el mensaje de abajo.', 'FR': 'x'}, {'message': 'block_msg', 'EN': 'Block', 'ES': 'Bloque', 'FR': 'x'}, {'message': 'out_of_msg', 'EN': 'out of', 'ES': 'de ', 'FR': 'x'}, {'message': 'block_end_msg', 'EN': 'End of block', 'ES': 'Final del bloque', 'FR': 'x'}, {'message': 'proceed_task_msg', 'EN': 'Proceed to task', 'ES': 'Continuar a la tarea', 'FR': 'x'}, {'message': 'handedness_msg', 'EN': 'What is your preferred or dominant hand?', 'ES': '¿Cuál es tu mano preferida o dominante?', 'FR': 's'}, {'message': 'left_handed_msg', 'EN': 'Left', 'ES': 'Izquierda', 'FR': 's'}, {'message': 'right_handed_msg', 'EN': 'Right', 'ES': 'Derecha', 'FR': 's'}, {'message': 'correct_exe_msg', 'EN': 'Sequence correct!', 'ES': 'Secuencia correcta!', 'FR': 's'}, {'message': 'incorrect_exe_msg', 'EN': 'Sequence incorrect. Please, correctly type the sequence. You will repeat the trial.', 'ES': 'Secuencia incorrecta. Por favor escribe la secuencia correctamente. Debes repetir el trial.', 'FR': 's'}, {'message': 'correct_ima_msg', 'EN': 'Keys correct!', 'ES': 'Teclas correctas!', 'FR': 's'}, {'message': 'incorrect_ima_msg', 'EN': 'Keys incorrect. You must start and finish with the same key. You will repeat the trial.', 'ES': 'Teclas incorrectas.Tienes que empezar y terminar con la misma tecla. Debes repetir el trial.', 'FR': 's'}, {'message': 'trial_complete_msg', 'EN': 'Trial completed', 'ES': 'Trial completado', 'FR': 's'}, {'message': 'correct_trials_msg', 'EN': 'Correct trials: ', 'ES': 'Ensayos correctos: ', 'FR': 's'}, {'message': 'visual_msg', 'EN': 'Visual modality', 'ES': 'Modalidad visual', 'FR': 'x'}, {'message': 'kine_msg', 'EN': 'Kinesthetic modality', 'ES': 'Modalidad cinestésica', 'FR': 'x'}, {'message': 'both_msg', 'EN': 'Both modalities', 'ES': 'Ambas modalidades', 'FR': 'x'}, {'message': 'next_msg', 'EN': 'Next', 'ES': 'Siguiente', 'FR': 'x'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="messages.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="messages_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="update_msg"/>
    <LoopTerminator name="messages_loop"/>
    <Routine name="welcome"/>
    <Routine name="demographics"/>
    <LoopInitiator loopType="TrialHandler" name="instructions_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'hand': 'right', 'inst_pic': 'images/seq_right.png', 'image_w': 0, 'image_h': 0, 'text_x': 0, 'inst_msg_EN': 'In this task you will type or imagine typing two 8-digit sequences with your RIGHT hand. Sometimes you will PHYSICALLY type the sequence. Other times you will only IMAGINE typing the sequence. During imagery, you will be asked to focus on BOTH the: \n\nVISUAL aspects of the movement (i.e. imagining SEEING your fingers moving from an INTERNAL point of view or FIRST-PERSON perspective)\n\nKINESTHETIC aspects of the movement (i.e. imagining FEELING your muscles contracting and your joints moving)\n\nPlease, always aim to focus on BOTH ASPECTS AT THE SAME TIME, even if it is not natural to do so. If you found it difficult, after the task you will have the option to explain your experience.', 'inst_msg_ES': 'En esta tarea, escribirás o imaginarás escribir dos secuencias de 8 dígitos con tu mano DERECHA. A veces escribirás FÍSICAMENTE la secuencia. Otras veces solo IMAGINARÁS escribir la secuencia. Durante la imaginación, se te pedirá que te concentres tanto en los: \n\naspectos VISUALES del movimiento (es decir, imaginar VER cómo se mueven tus dedos desde un punto de vista INTERNO o una perspectiva en PRIMERA PERSONA)\n\naspectos CINESTÉSICOS del movimiento (es decir, imaginar SENTIR cómo se contraen tus músculos y se mueven tus articulaciones).\n\nPor favor, intenta siempre concentrarte en AMBOS ASPECTOS AL MISMO TIEMPO, aunque no te resulte natural. Si te resulta difícil, después de la tarea tendrás la opción de explicar tu experiencia.', 'inst_msg_FR': &quot;Dans cette tâche, vous devrez taper ou imaginer taper deux séquences de 8 chiffres avec votre main DROITE. Parfois, vous taperez PHYSIQUEMENT la séquence. D'autres fois, vous vous contenterez d'IMAGINER taper la séquence. Pendant l'imagerie, on vous demandera de vous concentrer à la fois sur : \n\nles aspects VISUELS du mouvement (c'est-à-dire imaginer VOIR vos doigts bouger d'un point de vue INTERNE ou à la PREMIÈRE PERSONNE)\n\nles aspects KINESTHÉTIQUES du mouvement (c'est-à-dire imaginer que vous SENTEZ vos muscles se contracter et vos articulations bouger)\n\nVeuillez toujours essayer de vous concentrer sur LES DEUX ASPECTS EN MÊME TEMPS, même si cela ne vous semble pas naturel. Si vous avez trouvé cela difficile, vous aurez la possibilité d'expliquer votre expérience après l'exercice.&quot;, 'inst_msg_DE': 'In dieser Aufgabe werden Sie zwei 8-stellige Sequenzen mit Ihrer RECHTEN Hand tippen oder sich vorstellen zu tippen. Manchmal werden Sie die Sequenz PHYSISCH tippen. Zu anderen Zeiten werden Sie sich das Tippen der Sequenz nur VORSTELLEN. Während der Vorstellung werden Sie gebeten, sich auf BEIDE der folgenden Aspekte zu konzentrieren:\n\nVISUELLE Aspekte der Bewegung (d. h. sich vorzustellen, wie Sie Ihre Finger aus einer INTERNEN Perspektive bzw. aus der ICH-PERSPEKTIVE bewegen)\n\nKINÄSTHETISCHE Aspekte der Bewegung (d. h. sich vorzustellen, wie sich Ihre Muskeln zusammenziehen und sich Ihre Gelenke bewegen)\n\nBitte versuchen Sie immer, sich auf BEIDE ASPEKTE GLEICHZEITIG zu konzentrieren, auch wenn sich dies nicht natürlich anfühlt. Falls Ihnen dies schwergefallen ist, haben Sie nach der Aufgabe die Möglichkeit, Ihre Erfahrung zu erläutern.'}, {'hand': 'left', 'inst_pic': 'images/seq_left.png', 'image_w': 0, 'image_h': 0, 'text_x': 0, 'inst_msg_EN': 'In this task you will type or imagine typing two 8-digit sequences with your LEFT hand. Sometimes you will PHYSICALLY type the sequence. Other times you will only IMAGINE typing the sequence. During imagery, you will be asked to focus on BOTH the: \n\nVISUAL aspects of the movement (i.e. imagining SEEING your fingers moving from an INTERNAL point of view or FIRST-PERSON perspective)\n\nKINESTHETIC aspects of the movement (i.e. imagining FEELING your muscles contracting and your joints moving)\n\nPlease, always aim to focus on BOTH ASPECTS AT THE SAME TIME, even if it is not natural to do so. If you found it difficult, after the task you will have the option to explain your experience.', 'inst_msg_ES': 'En esta tarea, escribirás o imaginarás escribir dos secuencias de 8 dígitos con tu mano IZQUIERDA. A veces escribirás FÍSICAMENTE la secuencia. Otras veces solo IMAGINARÁS escribir la secuencia. Durante la imaginación, se te pedirá que te concentres tanto en los: \n\naspectos VISUALES del movimiento (es decir, imaginar VER cómo se mueven tus dedos desde un punto de vista INTERNO o una perspectiva en PRIMERA PERSONA)\n\naspectos CINESTÉSICOS del movimiento (es decir, imaginar SENTIR cómo se contraen tus músculos y se mueven tus articulaciones).\n\nPor favor, intenta siempre concentrarte en AMBOS ASPECTOS AL MISMO TIEMPO, aunque no te resulte natural. Si te resulta difícil, después de la tarea tendrás la opción de explicar tu experiencia.', 'inst_msg_FR': &quot;Dans cette tâche, vous devrez taper ou imaginer taper deux séquences de 8 chiffres avec votre main GAUCHE. Parfois, vous taperez PHYSIQUEMENT la séquence. D'autres fois, vous vous contenterez d'IMAGINER taper la séquence. Pendant l'imagerie, on vous demandera de vous concentrer à la fois sur : \n\nles aspects VISUELS du mouvement (c'est-à-dire imaginer VOIR vos doigts bouger d'un point de vue INTERNE ou à la PREMIÈRE PERSONNE)\n\nles aspects KINESTHÉTIQUES du mouvement (c'est-à-dire imaginer que vous SENTEZ vos muscles se contracter et vos articulations bouger)\n\nVeuillez toujours essayer de vous concentrer sur LES DEUX ASPECTS EN MÊME TEMPS, même si cela ne vous semble pas naturel. Si vous avez trouvé cela difficile, vous aurez la possibilité d'expliquer votre expérience après l'exercice.&quot;, 'inst_msg_DE': 'In dieser Aufgabe werden Sie zwei 8-stellige Sequenzen mit Ihrer LINKEN Hand tippen oder sich vorstellen zu tippen. Manchmal werden Sie die Sequenz PHYSISCH tippen. Zu anderen Zeiten werden Sie sich das Tippen der Sequenz nur VORSTELLEN. Während der Vorstellung werden Sie gebeten, sich auf BEIDE der folgenden Aspekte zu konzentrieren:\n\nVISUELLE Aspekte der Bewegung (d. h. sich vorzustellen, wie Sie Ihre Finger aus einer INTERNEN Perspektive bzw. aus der ICH-PERSPEKTIVE bewegen)\n\nKINÄSTHETISCHE Aspekte der Bewegung (d. h. sich vorzustellen, wie sich Ihre Muskeln zusammenziehen und sich Ihre Gelenke bewegen)\n\nBitte versuchen Sie immer, sich auf BEIDE ASPEKTE GLEICHZEITIG zu konzentrieren, auch wenn sich dies nicht natürlich anfühlt. Falls Ihnen dies schwergefallen ist, haben Sie nach der Aufgabe die Möglichkeit, Ihre Erfahrung zu erläutern.'}, {'hand': 'right', 'inst_pic': 'images/seq_right.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'For the task you will use the four fingers of your dominant hand.\n\nPlease place your right hand on the keyboard with your fingers on the buttons shown:\n\nF = Index\nG = Middle\nH = Ring\nJ = Little\n\nThroughout the task, please maintain your hand in this position.', 'inst_msg_ES': 'Para realizar la tarea, utilizarás los cuatro dedos de tu mano dominante.\n\nColoca tu mano derecha sobre el teclado con los dedos sobre las teclas que se indican a continuación:\n\nF = Índice\nG = Medio\nH = Anular\nJ = Meñique\n\nMantén la mano en esta posición durante toda la tarea.', 'inst_msg_FR': 'Pour cette tâche, vous utiliserez les quatre doigts de votre main dominante.\n\nVeuillez placer votre main droite sur le clavier, les doigts sur les touches indiquées :\n\nF = Index\nG = Majeur\nH = Annulaire\nJ = Petit doigt\n\nTout au long de la tâche, veuillez maintenir votre main dans cette position.', 'inst_msg_DE': 'Für die Aufgabe verwenden Sie die vier Finger Ihrer dominanten Hand.\n\nBitte legen Sie Ihre RECHTE Hand auf die Tastatur, wobei Ihre Finger auf den angezeigten Tasten liegen:\n\nF = Zeigefinger\nG = Mittelfinger\nH = Ringfinger\nJ = Kleiner Finger\n\nBitte halten Sie während der gesamten Aufgabe Ihre Hand in dieser Position.'}, {'hand': 'left', 'inst_pic': 'images/seq_left.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'For the task you will use the four fingers of your dominant hand.\n\nPlease place your hand on the keyboard with your fingers on the buttons shown:\n\nJ = Index\nH = Middle\nG = Ring\nF = Little\n\nThroughout the task, please maintain your hand in this position.', 'inst_msg_ES': 'Para realizar la tarea, utilizarás los cuatro dedos de tu mano dominante.\n\nColoca tu mano sobre el teclado con los dedos sobre las teclas que se indican a continuación:\n\nJ = Índice\nH = Medio\nG = Anular\nF = Meñique\n\nMantén la mano en esta posición durante toda la tarea.', 'inst_msg_FR': 'Pour cette tâche, vous utiliserez les quatre doigts de votre main dominante.\n\nVeuillez placer votre main droite sur le clavier, les doigts sur les touches indiquées :\n\nJ = Index\nH = Majeur\nG = Annulaire\nF = Petit doigt\n\nTout au long de la tâche, veuillez maintenir votre main dans cette position.', 'inst_msg_DE': 'Für die Aufgabe verwenden Sie die vier Finger Ihrer dominanten Hand.\n\nBitte legen Sie Ihre Hand auf die Tastatur, wobei Ihre Finger auf den angezeigten Tasten liegen:\n\nJ = Zeigefinger\nH = Mittelfinger\nG = Ringfinger\nF = Kleiner Finger\n\nBitte halten Sie während der gesamten Aufgabe Ihre Hand in dieser Position.'}, {'hand': 'right', 'inst_pic': 'images/seq_simple_right.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'This is an example sequence. DO NOT practice the sequence at this stage.\n\nIn the image, you can see that each black dot corresponds to a key press. The black line indicates what should be next key press.\n\nIn the case of this sequence, the correct order would be:\n\nIndex-Middle-Ring-Little-Little-Ring-Middle-Index', 'inst_msg_ES': 'Esta es una secuencia de ejemplo. NO practiques la secuencia en este momento.\n\nEn la imagen, puedes ver que cada punto negro corresponde a una pulsación de tecla. La línea negra indica cuál debería ser la siguiente.\n\nEn el caso de esta secuencia, el orden correcto sería:\n\nÍndice-Medio-Anular-Meñique-Meñique-Anular-Medio-Índice', 'inst_msg_FR': &quot;Il s'agit d'un exemple de séquence. NE pratiquez PAS la séquence à ce stade.\n\nSur l'image, vous pouvez voir que chaque point noir correspond à une pression sur une touche. La ligne noire indique la touche sur laquelle vous devez appuyer ensuite.\n\nDans le cas de cette séquence, l'ordre correct serait :\n\nIndex-Majeur-Annulaire-Auriculaire-Annulaire-Majeur-Index&quot;, 'inst_msg_DE': 'Dies ist eine Beispielsequenz. ÜBEN Sie die Sequenz zu diesem Zeitpunkt NICHT.\n\nIm Bild können Sie sehen, dass jeder schwarze Punkt einem Tastendruck entspricht. Die schwarze Linie zeigt an, welcher Tastendruck als Nächstes erfolgen sollte.\n\nIm Fall dieser Sequenz wäre die korrekte Reihenfolge:\n\nZeigefinger-Mittelfinger-Ringfinger-Kleiner Finger-Kleiner Finger-Ringfinger-Mittelfinger-Zeigefinger'}, {'hand': 'left', 'inst_pic': 'images/seq_simple_left.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'This is an example sequence. DO NOT practice the sequence at this stage.\n\nIn the image, you can see that each black dot corresponds to a key press. The black line indicates what should be next key press.\n\nIn the case of this sequence, the correct order would be:\n\nIndex-Middle-Ring-Little-Little-Ring-Middle-Index', 'inst_msg_ES': 'Esta es una secuencia de ejemplo. NO practiques la secuencia en este momento.\n\nEn la imagen, puedes ver que cada punto negro corresponde a una pulsación de tecla. La línea negra indica cuál debería ser la siguiente.\n\nEn el caso de esta secuencia, el orden correcto sería:\n\nÍndice-Medio-Anular-Meñique-Meñique-Anular-Medio-Índice', 'inst_msg_FR': &quot;Il s'agit d'un exemple de séquence. NE pratiquez PAS la séquence à ce stade.\n\nSur l'image, vous pouvez voir que chaque point noir correspond à une pression sur une touche. La ligne noire indique la touche sur laquelle vous devez appuyer ensuite.\n\nDans le cas de cette séquence, l'ordre correct serait :\n\nIndex-Majeur-Annulaire-Auriculaire-Annulaire-Majeur-Index&quot;, 'inst_msg_DE': 'Dies ist eine Beispielsequenz. ÜBEN Sie die Sequenz zu diesem Zeitpunkt NICHT.\n\nIm Bild können Sie sehen, dass jeder schwarze Punkt einem Tastendruck entspricht. Die schwarze Linie zeigt an, welcher Tastendruck als Nächstes erfolgen sollte.\n\nIm Fall dieser Sequenz wäre die korrekte Reihenfolge:\n\nZeigefinger-Mittelfinger-Ringfinger-Kleiner Finger-Kleiner Finger-Ringfinger-Mittelfinger-Zeigefinger'}, {'hand': 'right', 'inst_pic': 'images/seq_complex_right.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'This is another example of a sequence. DO NOT practice the sequence at this stage.\n\nHere the correct order would be:\n\nIndex-Little-Middle-Ring-Ring-Middle-Little-Index', 'inst_msg_ES': 'Este es otro ejemplo de secuencia. NO practiques la secuencia en esta etapa.\n\nAquí, el orden correcto sería:\n\nÍndice-Meñique-Medio-Anular-Anular-Medio-Meñique-Índice', 'inst_msg_FR': &quot;Voici un autre exemple de séquence. NE pratiquez PAS la séquence à ce stade.\n\nIci, l'ordre correct serait :\n\nIndex-Petit-Majeur-Annulaire-Annulaire-Majeur-Petit-Index&quot;, 'inst_msg_DE': 'Dies ist ein weiteres Beispiel für eine Sequenz. ÜBEN Sie die Sequenz zu diesem Zeitpunkt NICHT.\n\nHier wäre die korrekte Reihenfolge:\n\nZeigefinger-Kleiner Finger-Mittelfinger-Ringfinger-Ringfinger-Mittelfinger-Kleiner Finger-Zeigefinger'}, {'hand': 'left', 'inst_pic': 'images/seq_complex_left.png', 'image_w': 0.5, 'image_h': 0.4, 'text_x': -0.3, 'inst_msg_EN': 'This is another example of a sequence. DO NOT practice the sequence at this stage.\n\nHere the correct order would be:\n\nIndex-Little-Middle-Ring-Ring-Middle-Little-Index', 'inst_msg_ES': 'Este es otro ejemplo de secuencia. NO practiques la secuencia en esta etapa.\n\nAquí, el orden correcto sería:\n\nÍndice-Meñique-Medio-Anular-Anular-Medio-Meñique-Índice', 'inst_msg_FR': &quot;Voici un autre exemple de séquence. NE pratiquez PAS la séquence à ce stade.\n\nIci, l'ordre correct serait :\n\nIndex-Petit-Majeur-Annulaire-Annulaire-Majeur-Petit-Index&quot;, 'inst_msg_DE': 'Dies ist ein weiteres Beispiel für eine Sequenz. ÜBEN Sie die Sequenz zu diesem Zeitpunkt NICHT.\n\nHier wäre die korrekte Reihenfolge:\n\nZeigefinger-Kleiner Finger-Mittelfinger-Ringfinger-Ringfinger-Mittelfinger-Kleiner Finger-Zeigefinger'}, {'hand': 'right', 'inst_pic': 'images/seq_execution_right.png', 'image_w': 0.6, 'image_h': 0.5, 'text_x': -0.3, 'inst_msg_EN': 'When you are PHYSICALLY executing the sequence, you will have to press all the keys to finish the trial.\n\nYou will see these images in this case.', 'inst_msg_ES': 'Cuando estés ejecutando FÍSICAMENTE la secuencia, tendrás que pulsar todas las teclas para terminar ese intento.\n\nEn este caso, verás estas imágenes.', 'inst_msg_FR': &quot;Lorsque vous exécutez PHYSIQUEMENT la séquence, vous devrez appuyer sur toutes les touches pour terminer l'essai.\n\nDans ce cas, vous verrez ces images.&quot;, 'inst_msg_DE': 'Wenn Sie die Sequenz PHYSISCH AUSFÜHREN, müssen Sie alle Tasten drücken, um den Durchgang zu beenden.\n\nSie sehen in diesem Fall diese Bilder.'}, {'hand': 'left', 'inst_pic': 'images/seq_execution_left.png', 'image_w': 0.6, 'image_h': 0.5, 'text_x': -0.3, 'inst_msg_EN': 'When you are PHYSICALLY executing the sequence, you will have to press all the keys to finish the trial.\n\nYou will see these images in this case.', 'inst_msg_ES': 'Cuando estés ejecutando FÍSICAMENTE la secuencia, tendrás que pulsar todas las teclas para terminar ese intento.\n\nEn este caso, verás estas imágenes.', 'inst_msg_FR': &quot;Lorsque vous exécutez PHYSIQUEMENT la séquence, vous devrez appuyer sur toutes les touches pour terminer l'essai.\n\nDans ce cas, vous verrez ces images.&quot;, 'inst_msg_DE': 'Wenn Sie die Sequenz PHYSISCH AUSFÜHREN, müssen Sie alle Tasten drücken, um den Durchgang zu beenden.\n\nSie sehen in diesem Fall diese Bilder.'}, {'hand': 'right', 'inst_pic': 'images/seq_imagery_right.png', 'image_w': 0.6, 'image_h': 0.5, 'text_x': -0.3, 'inst_msg_EN': 'When you are IMAGINING the sequence, press ONLY the FIRST key of the sequence, IMAGINE the following movements, and press the LAST key again.\n\nIn the example shown, you would:\nPhysically press with the index.\nImagine pressing with the rest of the fingers.\nPhysically press with the index.\n\nWhen you are imagining the movements, DO NOT MOVE your hand, keep it still over the indicated keys.', 'inst_msg_ES': 'Cuando IMAGINES la secuencia, pulsa SOLO la PRIMERA tecla de la secuencia, IMAGINA los siguientes movimientos y vuelve a pulsar la ÚLTIMA tecla.\n\nEn el ejemplo mostrado, harías lo siguiente:\nPulsa físicamente con el índice.\nImagina que pulsas con el resto de los dedos.\nPulsa físicamente con el índice.\n\nCuando imagines los movimientos, NO MUEVAS la mano, mantenla quieta sobre las teclas indicadas.', 'inst_msg_FR': &quot;Lorsque vous IMAGINEZ la séquence, appuyez UNIQUEMENT sur la PREMIÈRE touche de la séquence, IMAGINEZ les mouvements suivants, puis appuyez à nouveau sur la DERNIÈRE touche.\n\nDans l'exemple présenté, vous devriez :\nAppuyer physiquement avec l'index.\nImaginer appuyer avec les autres doigts.\nAppuyer physiquement avec l'index.\n\nLorsque vous imaginez les mouvements, NE BOUGEZ PAS votre main, gardez-la immobile au-dessus des touches indiquées.&quot;, 'inst_msg_DE': 'Wenn Sie sich die Sequenz VORSTELLEN, drücken Sie NUR die ERSTE Taste der Sequenz, STELLEN sich die folgenden Bewegungen vor und drücken anschließend erneut die LETZTE Taste.\n\nIm gezeigten Beispiel würden Sie:\nPhysisch mit dem Zeigefinger drücken.\nSich das Drücken mit den übrigen Fingern vorstellen.\nPhysisch erneut mit dem Zeigefinger drücken.\n\nWenn Sie sich die Bewegungen vorstellen, BEWEGEN Sie Ihre Hand NICHT, halten Sie sie ruhig über den angegebenen Tasten.'}, {'hand': 'left', 'inst_pic': 'images/seq_imagery_left.png', 'image_w': 0.6, 'image_h': 0.5, 'text_x': -0.3, 'inst_msg_EN': 'When you are IMAGINING the sequence, press ONLY the FIRST key of the sequence, IMAGINE the following movements, and press the LAST key again.\n\nIn the example shown, you would:\nPhysically press with the index.\nImagine pressing with the rest of the fingers.\nPhysically press with the index.\n\nWhen you are imagining the movements, DO NOT MOVE your hand, keep it still over the indicated keys.', 'inst_msg_ES': 'Cuando IMAGINES la secuencia, pulsa SOLO la PRIMERA tecla de la secuencia, IMAGINA los siguientes movimientos y vuelve a pulsar la ÚLTIMA tecla.\n\nEn el ejemplo mostrado, harías lo siguiente:\nPulsa físicamente con el índice.\nImagina que pulsas con el resto de los dedos.\nPulsa físicamente con el índice.\n\nCuando imagines los movimientos, NO MUEVAS la mano, mantenla quieta sobre las teclas indicadas.', 'inst_msg_FR': &quot;Lorsque vous IMAGINEZ la séquence, appuyez UNIQUEMENT sur la PREMIÈRE touche de la séquence, IMAGINEZ les mouvements suivants, puis appuyez à nouveau sur la DERNIÈRE touche.\n\nDans l'exemple présenté, vous devriez :\nAppuyer physiquement avec l'index.\nImaginer appuyer avec les autres doigts.\nAppuyer physiquement avec l'index.\n\nLorsque vous imaginez les mouvements, NE BOUGEZ PAS votre main, gardez-la immobile au-dessus des touches indiquées.&quot;, 'inst_msg_DE': 'Wenn Sie sich die Sequenz VORSTELLEN, drücken Sie NUR die ERSTE Taste der Sequenz, STELLEN sich die folgenden Bewegungen vor und drücken anschließend erneut die LETZTE Taste.\n\nIm gezeigten Beispiel würden Sie:\nPhysisch mit dem Zeigefinger drücken.\nSich das Drücken mit den übrigen Fingern vorstellen.\nPhysisch erneut mit dem Zeigefinger drücken.\n\nWenn Sie sich die Bewegungen vorstellen, BEWEGEN Sie Ihre Hand NICHT, halten Sie sie ruhig über den angegebenen Tasten.'}, {'hand': 'right', 'inst_pic': 'images/seq_right.png', 'image_w': 0, 'image_h': 0, 'text_x': 0, 'inst_msg_EN': 'The goal of the task is to complete the sequence as QUICKLY and ACCURATELY as you can, in both execution and imagery.\n\nHowever, we ask you to PRIORITISE ACCURACY over speed. That is, try to complete the task as quickly as you can, while ensuring you  complete the sequence correctly.\n\nYou do not have to start typing or imagining immediately after the trial begins, but when you start the movement, try to complete it as quickly and accurately as you can.', 'inst_msg_ES': 'El objetivo de la tarea es completar la secuencia lo más RÁPIDA y PRECISAMENTE posible, tanto en la ejecución como en la imaginación.\n\nSin embargo, te pedimos que PRIORICES LA PRECISIÓN sobre la velocidad. Es decir, intenta completar la tarea lo más rápido posible, asegurándote de completar la secuencia correctamente.\n\nNo es necesario que empieces a escribir o a imaginar inmediatamente después de que comience cada intento, pero cuando empiece el movimiento, intenta completarlo lo más rápido y con la mayor precisión posible.', 'inst_msg_FR': &quot;L'objectif de l'exercice est d'effectuer la séquence aussi RAPIDEMENT et PRÉCISÉMENT que possible, tant au niveau de l'exécution que de l'imagerie mentale.\n\nCependant, nous vous demandons de PRIVILÉGIER LA PRÉCISION plutôt que la vitesse. Autrement dit, essayez d'effectuer l'exercice aussi rapidement que possible, tout en veillant à  effectuer la séquence correctement.\n\nVous n'êtes pas obligé de commencer à taper ou à imaginer immédiatement après le début de l'essai, mais lorsque vous commencez le mouvement, essayez de le réaliser aussi rapidement et précisément que possible.&quot;, 'inst_msg_DE': 'Ziel der Aufgabe ist es, die Sequenz sowohl bei der Ausführung als auch bei der Vorstellung so SCHNELL und GENAU wie möglich zu absolvieren.\n\nWir bitten Sie jedoch, die GENAUIGKEIT gegenüber der Geschwindigkeit zu PRIORISIEREN. Das heißt, versuchen Sie, die Aufgabe so schnell wie möglich zu erledigen, während Sie sicherstellen, dass Sie die Sequenz korrekt ausführen.\n\nSie müssen nicht sofort nach Beginn des Durchgangs mit dem Tippen oder Vorstellen beginnen, aber sobald Sie die Bewegung starten, versuchen Sie, sie so schnell und genau wie möglich abzuschließen.'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="ifst_files/instructions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="instructions_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="instructions"/>
    <LoopTerminator name="instructions_loop"/>
    <LoopInitiator loopType="TrialHandler" name="blocks_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="total_blocks" valType="num"/>
      <Param name="name" updates="None" val="blocks_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="block_start"/>
    <LoopInitiator loopType="TrialHandler" name="seq_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'hand': 'right', 'stim': 1, 'sequence_code': 'fghjjhgf', 'sequence_type': 'simple', 'trial_type': 'execution', 'key_presses': 8, 'sequence_picture': 'stimuli/simple_execution_right.png', 'prompt_before_EN': 'In the next trial, you will have to PHYSICALLY EXECUTE the movement.\n\nRemember you have to press ALL the keys.', 'prompt_EN': 'Physically EXECUTE this sequence\n(press all keys).', 'prompt_before_ES': 'En el próximo intento, tienes que EJECUTAR FÍSICAMENTE el movimiento.\n\nRecuerda que debes presionar TODAS las teclas.', 'prompt_ES': 'EJECUTA físicamente esta secuencia\n(presiona todas las teclas)'}, {'hand': 'left', 'stim': 1, 'sequence_code': 'jhgffghj', 'sequence_type': 'simple', 'trial_type': 'execution', 'key_presses': 8, 'sequence_picture': 'stimuli/simple_execution_left.png', 'prompt_before_EN': 'In the next trial, you will have to PHYSICALLY EXECUTE the movement.\n\nRemember you have to press ALL the keys.', 'prompt_EN': 'Physically EXECUTE this sequence\n(press all keys).', 'prompt_before_ES': 'En el próximo intento, tienes que EJECUTAR FÍSICAMENTE el movimiento.\n\nRecuerda que debes presionar TODAS las teclas.', 'prompt_ES': 'EJECUTA físicamente esta secuencia\n(presiona todas las teclas)'}, {'hand': 'right', 'stim': 2, 'sequence_code': 'ff', 'sequence_type': 'simple', 'trial_type': 'imagery', 'key_presses': 2, 'sequence_picture': 'stimuli/simple_imagery_right.png', 'prompt_before_EN': 'In the next trial, you will have to IMAGINE the movement\n\nPlease, focus on BOTH SEEING AND FEELING the movement\n\nRemember you only need to press the FIRST and LAST keys', 'prompt_EN': 'IMAGINE this sequence\n(press only the First/Last keys).', 'prompt_before_ES': 'En el próximo intento, tienes que IMAGINAR el movimiento\n\nPor favor concéntrato TANTO EN VER COMO EN SENTIR el movimiento\n\nRecuerda que solo debes presionar la PRIMERA y la ÚLTIMA tecla', 'prompt_ES': 'IMAGINA esta secuencia\n(presiona solo la Primera/Última tecla)'}, {'hand': 'left', 'stim': 2, 'sequence_code': 'jj', 'sequence_type': 'simple', 'trial_type': 'imagery', 'key_presses': 2, 'sequence_picture': 'stimuli/simple_imagery_left.png', 'prompt_before_EN': 'In the next trial, you will have to IMAGINE the movement\n\nPlease, focus on BOTH SEEING AND FEELING the movement\n\nRemember you only need to press the FIRST and LAST keys', 'prompt_EN': 'IMAGINE this sequence\n(press only the First/Last keys).', 'prompt_before_ES': 'En el próximo intento, tienes que IMAGINAR el movimiento\n\nPor favor concéntrato TANTO EN VER COMO EN SENTIR el movimiento\n\nRecuerda que solo debes presionar la PRIMERA y la ÚLTIMA tecla', 'prompt_ES': 'IMAGINA esta secuencia\n(presiona solo la Primera/Última tecla)'}, {'hand': 'right', 'stim': 3, 'sequence_code': 'fjghhgjf', 'sequence_type': 'complex', 'trial_type': 'execution', 'key_presses': 8, 'sequence_picture': 'stimuli/complex_execution_right.png', 'prompt_before_EN': 'In the next trial, you will have to PHYSICALLY EXECUTE the movement.\n\nRemember you have to press ALL the keys.', 'prompt_EN': 'Physically EXECUTE this sequence\n(press all keys).', 'prompt_before_ES': 'En el próximo intento, tienes que EJECUTAR FÍSICAMENTE el movimiento.\n\nRecuerda que debes presionar TODAS las teclas.', 'prompt_ES': 'EJECUTA físicamente esta secuencia\n(presiona todas las teclas)'}, {'hand': 'left', 'stim': 3, 'sequence_code': 'jfhgghfj', 'sequence_type': 'complex', 'trial_type': 'execution', 'key_presses': 8, 'sequence_picture': 'stimuli/complex_execution_left.png', 'prompt_before_EN': 'In the next trial, you will have to PHYSICALLY EXECUTE the movement.\n\nRemember you have to press ALL the keys.', 'prompt_EN': 'Physically EXECUTE this sequence\n(press all keys).', 'prompt_before_ES': 'En el próximo intento, tienes que EJECUTAR FÍSICAMENTE el movimiento.\n\nRecuerda que debes presionar TODAS las teclas.', 'prompt_ES': 'EJECUTA físicamente esta secuencia\n(presiona todas las teclas)'}, {'hand': 'right', 'stim': 4, 'sequence_code': 'ff', 'sequence_type': 'complex', 'trial_type': 'imagery', 'key_presses': 2, 'sequence_picture': 'stimuli/complex_imagery_right.png', 'prompt_before_EN': 'In the next trial, you will have to IMAGINE the movement\n\nPlease, focus on BOTH SEEING AND FEELING the movement\n\nRemember you only need to press the FIRST and LAST keys', 'prompt_EN': 'IMAGINE this sequence\n(press only the First/Last keys).', 'prompt_before_ES': 'En el próximo intento, tienes que IMAGINAR el movimiento\n\nPor favor concéntrato TANTO EN VER COMO EN SENTIR el movimiento\n\nRecuerda que solo debes presionar la PRIMERA y la ÚLTIMA tecla', 'prompt_ES': 'IMAGINA esta secuencia\n(presiona solo la Primera/Última tecla)'}, {'hand': 'left', 'stim': 4, 'sequence_code': 'jj', 'sequence_type': 'complex', 'trial_type': 'imagery', 'key_presses': 2, 'sequence_picture': 'stimuli/complex_imagery_left.png', 'prompt_before_EN': 'In the next trial, you will have to IMAGINE the movement\n\nPlease, focus on BOTH SEEING AND FEELING the movement\n\nRemember you only need to press the FIRST and LAST keys', 'prompt_EN': 'IMAGINE this sequence\n(press only the First/Last keys).', 'prompt_before_ES': 'En el próximo intento, tienes que IMAGINAR el movimiento\n\nPor favor concéntrato TANTO EN VER COMO EN SENTIR el movimiento\n\nRecuerda que solo debes presionar la PRIMERA y la ÚLTIMA tecla', 'prompt_ES': 'IMAGINA esta secuencia\n(presiona solo la Primera/Última tecla)'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$conditions_file" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="reps_per_block" valType="num"/>
      <Param name="name" updates="None" val="seq_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="pre_trial"/>
    <Routine name="seq_trial"/>
    <Routine name="seq_fb"/>
    <LoopTerminator name="seq_loop"/>
    <LoopInitiator loopType="TrialHandler" name="self_assess_loop">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'self_assess_question_EN': 'Please, respond the following questions about the imagery you performed in the LAST block.\nUse the mouse.\n\nIn the last block, the INSTRUCTION when IMAGINING the movement was to use:', 'label_min_EN': 'A visual\nmodality only', 'label_middle_EN': 'Both modalities\nat the same time', 'label_max_EN': 'A kinesthetic\nmodality only', 'self_assess_question_ES': 'Por favor, responde las siguientes preguntas sobre la imaginería que has realizado en el ÚLTIMO bloque.\nUsa el ratón.\n\nEn el último bloque la INSTRUCCIÓN durante la imaginación fue que usaras:', 'label_min_ES': 'La modalidad visual\núnicamente', 'label_middle_ES': 'Ambas modalidades\na la vez', 'label_max_ES': 'La modalidad cinestésica\núnicamente', 'self_assess_question_FR': &quot;Veuillez répondre aux questions suivantes concernant l'imagerie que vous avez réalisée dans le DERNIER bloc.\nUtilisez la souris.\n\nDans le dernier bloc, l'INSTRUCTION pour IMAGINER le mouvement était d'utiliser :&quot;, 'label_min_FR': 'Une modalité visuelle\nuniquement', 'label_middle_FR': 'Les deux modalités\nen même temps', 'label_max_FR': 'Une modalité kinesthésique\nuniquement', 'self_assess_question_DE': 'Bitte beantworten Sie die folgenden Fragen zur Vorstellung, die Sie im LETZTEN Block ausgeführt haben.\nVerwenden Sie die Maus.\n\nIm letzten Block lautete die ANWEISUNG beim VORSTELLEN der Bewegung, folgende Modalität zu verwenden:', 'label_min_DE': 'Nur eine visuelle Modalität', 'label_middle_DE': 'Beide Modalitäten\ngleichzeitig', 'label_max_DE': 'Nur eine kinästhetische Modalität'}, {'self_assess_question_EN': 'When imagining the movement, what was the OVERALL VIVIDNESS (considering BOTH the clarity of the image AND the intensity of the sensations)? Only if you did not feel or see anything at all, then select 0.', 'label_min_EN': 'No image at all, you only\n&quot;know&quot; that you were\nthinking of the movement', 'label_middle_EN': '  ', 'label_max_EN': 'Perfectly clear and vivid as\nnormal vision and/or\nfeel of movement', 'self_assess_question_ES': 'Al imaginar el movimiento,  ¿cuál fue tu VIVEZA GENERAL (considerando TANTO la claridad de la imaginen COMO la intensidad de las sensaciones)? Solo si no has visto o sentido nada, selecciona 0.', 'label_min_ES': 'Ninguna imagen,\nsolo &quot;sabes&quot; que\npensabas sobre la acción', 'label_middle_ES': ' ', 'label_max_ES': 'Perfectamente clara y\ntan vívida como ver y\nsentir el movimiento', 'self_assess_question_FR': &quot;Lorsque vous avez imaginé le mouvement, quelle était la VIVACITÉ GÉNÉRALE (en tenant compte À LA FOIS de la clarté de l'image ET de l'intensité des sensations) ? Si vous n'avez rien ressenti ni vu du tout, sélectionnez 0.&quot;, 'label_min_FR': 'Aucune image, vous savez\nseulement que vous\npensiez au mouvement.', 'label_middle_FR': ' ', 'label_max_FR': 'Parfaitement clair et net\ncomme une vision normale\net/ou sensation de mouvement', 'self_assess_question_DE': 'Wie lebhaft war die Vorstellung der Bewegung INSGESAMT (unter Berücksichtigung SOWOHL der Klarheit des Bildes ALS AUCH der Intensität der Empfindungen)? Wählen Sie nur dann 0, wenn Sie überhaupt nichts gesehen oder gefühlt haben.', 'label_min_DE': 'Kein Bild überhaupt, Sie „wussten“ nur, dass Sie an die Bewegung gedacht haben', 'label_middle_DE': '   ', 'label_max_DE': 'Vollkommen klar und lebhaft, wie normales Sehen und/oder das normale Gefühl einer Bewegung'}, {'self_assess_question_EN': 'When imagining the movement, did you imagine yourself making errors (e.g. pressing the wrong key)? Only if you imagined NO ERRORS in the WHOLE BLOCK, then select 0.', 'label_min_EN': 'No errors, I was\ncompletely accurate\nduring imagery', 'label_middle_EN': '  ', 'label_max_EN': 'A lot of errors, I was\ncompletely inaccurate\nduring imagery', 'self_assess_question_ES': 'Al imaginar el movimiento,  ¿lo has imaginado cometiendo errores (es decir, presionar la tecla incorrecta)? Solo si no has imaginado NINGÚN ERROR en TODO el bloque, selecciona 0.', 'label_min_ES': 'Sin errores,\ncompleteamente\npreciso/a', 'label_middle_ES': ' ', 'label_max_ES': 'Muchos errores,\ncompletamente\nimpreciso/a', 'self_assess_question_FR': &quot;Lorsque vous avez imaginé le mouvement, vous êtes-vous imaginé en train de faire des erreurs (par exemple, appuyer sur la mauvaise touche) ? Seulement si vous n'avez imaginé AUCUNE ERREUR dans TOUT LE BLOC, sélectionnez 0.&quot;, 'label_min_FR': &quot;Aucune erreur, j'étais\ntout à fait précis\npendant l'imagerie.&quot;, 'label_middle_FR': '  ', 'label_max_FR': &quot;Beaucoup d'erreurs, j'étais\ncomplètement inexact\npendant l'imagerie&quot;, 'self_assess_question_DE': 'Haben Sie sich beim Vorstellen der Bewegung Fehler vorgestellt (z. B. die falsche Taste gedrückt)? Wählen Sie nur dann 0, wenn Sie sich im GESAMTEN BLOCK KEINE FEHLER vorgestellt haben.', 'label_min_DE': 'Keine Fehler, ich war während der Vorstellung vollständig korrekt', 'label_middle_DE': '   ', 'label_max_DE': 'Viele Fehler, ich war während der Vorstellung völlig ungenau'}, {'self_assess_question_EN': 'When imagining the movement, what was your use of the VISUAL MODALITY of imagery (creating a visual image of the movement)? Only if you did not use visual imagery at all, select &quot;0&quot;.', 'label_min_EN': 'No visual\nimagery use', 'label_middle_EN': '  ', 'label_max_EN': 'High visual\nimagery use', 'self_assess_question_ES': 'Al imaginar el movimiento, ¿cuál ha sido tu uso de la modalidad VISUAL (crear una imagen visual del moviemiento)? Solo si no has usado NADA la modalidad visual, selecciona 0.', 'label_min_ES': 'Ningún uso de la\nmodalidad visual', 'label_middle_ES': ' ', 'label_max_ES': 'Uso alto de la\nmodalidad visual', 'self_assess_question_FR': &quot;Lorsque vous avez imaginé le mouvement, comment avez-vous utilisé la MODALITÉ VISUELLE de l'imagerie (création d'une image visuelle du mouvement) ? Si vous n'avez pas utilisé du tout l'imagerie visuelle, sélectionnez « 0 ».&quot;, 'label_min_FR': &quot;Pas d'utilisation\nd'images visuelles&quot;, 'label_middle_FR': ' ', 'label_max_FR': &quot;Utilisation intensive\nd'images visuelles&quot;, 'self_assess_question_DE': 'Wie stark haben Sie beim Vorstellen der Bewegung die VISUELLE MODALITÄT der Vorstellung genutzt (ein visuelles Bild der Bewegung erzeugt)? Wählen Sie nur dann „0“, wenn Sie visuelle Vorstellung überhaupt nicht genutzt haben.', 'label_min_DE': 'Keine Nutzung visueller Vorstellung', 'label_middle_DE': '   ', 'label_max_DE': 'Hohe Nutzung visueller Vorstellung'}, {'self_assess_question_EN': 'If you used visual imagery, did you use a FIRST-PERSON PERSPECTIVE (watching the movement through the eyes of the performer, from an internal point of view)? If you selected 0 in the question before, then you must select 0 here as well.', 'label_min_EN': 'No first-person (internal)\nperspective use', 'label_middle_EN': '  ', 'label_max_EN': 'High first-person (internal)\nperspective use', 'self_assess_question_ES': 'Si has usado la modalidad visual, ¿cuál ha sido el uso de la PERSPETIVA EN PRIMERA PERSONA (ver el movimiento a través de los ojos de la persona que lo realiza, desde una perspectiva interna)? Si has seleccionado 0 en la pregunta previa, debes seleccionar 0 aquí también.', 'label_min_ES': 'Ningún uso de la\nperspectiva interna', 'label_middle_ES': ' ', 'label_max_ES': 'Uso alto de la\nperspectiva interna', 'self_assess_question_FR': &quot;Si vous avez utilisé des images visuelles, avez-vous utilisé une PERSPECTIVE À LA PREMIÈRE PERSONNE (en observant le mouvement à travers les yeux de l'interprète, d'un point de vue interne) ? Si vous avez sélectionné 0 dans la question précédente, vous devez également sélectionner 0 ici.&quot;, 'label_min_FR': &quot;Pas d'utilisation de la\nperspective à la première\npersonne (interne)&quot;, 'label_middle_FR': ' ', 'label_max_FR': 'Utilisation intensive de la\nperspective à la première\npersonne (interne)', 'self_assess_question_DE': 'Falls Sie visuelle Vorstellung genutzt haben: Haben Sie eine ERSTE-PERSON-PERSPEKTIVE verwendet (die Bewegung durch die Augen der ausführenden Person gesehen, aus einer internen Perspektive)? Wenn Sie in der vorherigen Frage 0 gewählt haben, müssen Sie hier ebenfalls 0 wählen.', 'label_min_DE': 'Keine Nutzung der Ich-Perspektive (intern)', 'label_middle_DE': '   ', 'label_max_DE': 'Hohe Nutzung der Ich-Perspektive (intern)'}, {'self_assess_question_EN': 'If you used visual imagery, did you use a THIRD-PERSON PERSPECTIVE (watching yourself performing the movement, from an external point of view)? If you selected 0 in the question about general visual imagery use, then you must select 0 here as well.', 'label_min_EN': 'No third-person (external)\nperspective use', 'label_middle_EN': '  ', 'label_max_EN': 'High third-person (external)\nperspective use', 'self_assess_question_ES': 'Si has usado la modalidad visual, ¿cuál ha sido el uso de la PERSPETIVA EN TERCERA PERSONA (verte a ti mismo/a realizar el movimiento desde fuera, desde una perspectiva externa)? Si has seleccionado 0 en la pregunta sobre el uso de la modalidad visual, debes seleccionar 0 aquí también.', 'label_min_ES': 'Ningún uso de la\nperspectiva externa', 'label_middle_ES': ' ', 'label_max_ES': 'Uso alto de la\nperspectiva externa', 'self_assess_question_FR': &quot;Si vous avez utilisé l'imagerie mentale, avez-vous utilisé une PERSPECTIVE À LA TROISIÈME PERSONNE (en vous observant effectuer le mouvement d'un point de vue extérieur) ? Si vous avez sélectionné 0 dans la question sur l'utilisation générale de l'imagerie mentale, vous devez également sélectionner 0 ici.&quot;, 'label_min_FR': &quot;Pas d'utilisation de la\nperspective à la troisième\npersonne (externe)&quot;, 'label_middle_FR': ' ', 'label_max_FR': 'Utilisation intensive de la\nperspective à la troisième\npersonne (externe)', 'self_assess_question_DE': 'Falls Sie visuelle Vorstellung genutzt haben: Haben Sie eine DRITTE-PERSON-PERSPEKTIVE verwendet (sich selbst bei der Ausführung der Bewegung beobachtet, aus einer externen Perspektive)? Wenn Sie in der Frage zur allgemeinen Nutzung visueller Vorstellung 0 gewählt haben, müssen Sie hier ebenfalls 0 wählen.', 'label_min_DE': 'Keine Nutzung der Dritte-Person-Perspektive (extern)', 'label_middle_DE': '   ', 'label_max_DE': 'Hohe Nutzung der Dritte-Person-Perspektive (extern)'}, {'self_assess_question_EN': 'When imagining the movement, what was your use of the KINESTHETIC MODALITY of imagery (feeling the sensations of the movement)? Only if you did not use kinesthetic imagery at all, select &quot;0&quot;.', 'label_min_EN': 'No kinesthetic\nimagery use', 'label_middle_EN': '  ', 'label_max_EN': 'High kinesthetic\nimagery use', 'self_assess_question_ES': 'Al imaginar el movimiento, ¿cuál ha sido tu uso de la modalidad CINESTÉSICA (sentir las sensaciones asociadas al movimiento)? Solo si no has usado NADA la modalidad cinestésica, selecciona 0.', 'label_min_ES': 'Ningún uso de la\nmodalidad cinestésica', 'label_middle_ES': ' ', 'label_max_ES': 'Uso alto de la\nmodalidad cinestésica', 'self_assess_question_FR': &quot;Lorsque vous avez imaginé le mouvement, dans quelle mesure avez-vous utilisé la MODALITÉ KINESTHÉTIQUE de l'imagerie (ressentir les sensations du mouvement) ? Ne sélectionnez « 0 » que si vous n'avez pas du tout utilisé l'imagerie cinesthésique.&quot;, 'label_min_FR': &quot;Pas d'utilisation\nd'images kinesthésiques&quot;, 'label_middle_FR': ' ', 'label_max_FR': &quot;Utilisation intensive de\nl'imagerie kinesthésique&quot;, 'self_assess_question_DE': 'Wie stark haben Sie beim Vorstellen der Bewegung die KINÄSTHETISCHE MODALITÄT der Vorstellung genutzt (die Empfindungen der Bewegung gespürt)? Wählen Sie nur dann „0“, wenn Sie kinästhetische Vorstellung überhaupt nicht genutzt haben.', 'label_min_DE': 'Keine Nutzung kinästhetischer Vorstellung', 'label_middle_DE': '   ', 'label_max_DE': 'Hohe Nutzung kinästhetischer Vorstellung'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="ifst_files/self_assess_questions.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="self_assess_show" valType="num"/>
      <Param name="name" updates="None" val="self_assess_loop" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="self_assess"/>
    <LoopTerminator name="self_assess_loop"/>
    <LoopTerminator name="blocks_loop"/>
    <Routine name="bye"/>
  </Flow>
</PsychoPy2experiment>
