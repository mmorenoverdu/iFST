      </RoutineSettingsComponent>
      <CodeComponent name="update_language_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# we define &quot;lang_code&quot; which is our variable to&amp;#10;# be used for the language localisation dynamically&amp;#10;# we set it to English as default language&amp;#10;lang_code = &quot;EN&quot;&amp;#10;thisExp.addData(&quot;language_code&quot;, lang_code)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="lang_code = &quot;EN&quot;;&amp;#10;psychoJS.experiment.addData(&quot;language_code&quot;, lang_code);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === expInfo[&quot;language&quot;])) {&amp;#10;    lang_code = ISO_code;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;language_code&quot;, lang_code);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# we put this code at the beginning of the routine.&amp;#10;# at this point the language has already been selected&amp;#10;# in the dialogue box by the participant&amp;#10;&amp;#10;# now we update the language code based on the&amp;#10;# language localiser variable ISO_code&amp;#10;if language == expInfo['language']:&amp;#10;    lang_code = ISO_code  &amp;#10;&amp;#10;thisExp.addData(&quot;language_code&quot;, lang_code)  # add it to output&amp;#10;&amp;#10;# this way now lang_code has the value of ISO_code&amp;#10;# where language in our Excel sheet matches with the&amp;#10;# language selected by the participant" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="update_language_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="update_msg">
      <RoutineSettingsComponent name="update_msg" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="update_msg" valType="code" updates="None" name="name"/>
        <Param val="False" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="update_messages_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="// change code that does not auto-translate correctly&amp;#10;// we use window instead of globals()&amp;#10;// to create the global variables&amp;#10;// the rest is the same&amp;#10;msg_name = message;&amp;#10;msg_value = eval(lang_code);&amp;#10;window[msg_name] = msg_value; // here is the change&amp;#10;psychoJS.experiment.addData(&quot;msg_name&quot;, msg_name);&amp;#10;psychoJS.experiment.addData(&quot;msg_value&quot;, msg_value);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="## THIS CODE DOES NOT AUTO-TRANSLATE!!!!&amp;#10;&amp;#10;# now that we have selected our new language (lang_code)&amp;#10;# we can use a loop to iterate over the messages&amp;#10;# every iteration, we're gonna update the value of our&amp;#10;# global variables with the value corresponding to the&amp;#10;# lang_code (ISO_code from the language localiser)&amp;#10;# this way we don't need to manually specify the text&amp;#10;&amp;#10;# this iteration, select the message&amp;#10;msg_name = message  # e.g. variable &quot;welcome_msg&quot;&amp;#10;# for this iteration, assign the value based on code&amp;#10;msg_value = eval(lang_code) # e.g. &quot;Bienvenido&quot; if lang_code = &quot;ES&quot;&amp;#10;# update message based on code&amp;#10;globals()[msg_name] = msg_value  # e.g. should update the value of welcome_msg by &quot;Bienvenido&quot;&amp;#10;# finally we add the values to output just to check&amp;#10;thisExp.addData(&quot;msg_name&quot;, msg_name)&amp;#10;thisExp.addData(&quot;msg_value&quot;, msg_value)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="update_messages_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
