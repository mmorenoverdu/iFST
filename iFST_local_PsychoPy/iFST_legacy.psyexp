        <Param val="psychoJS.experiment.addData(&quot;handedness&quot;, handedness);&amp;#10;if ((handedness === &quot;left&quot;)) {&amp;#10;    conditions_file = &quot;ifst_files/conditions_left.xlsx&quot;;&amp;#10;} else {&amp;#10;    conditions_file = &quot;ifst_files/conditions_right.xlsx&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData(&quot;handedness&quot;, handedness)&amp;#10;&amp;#10;if handedness == &quot;left&quot;:&amp;#10;    conditions_file = &quot;ifst_files/conditions_left.xlsx&quot;&amp;#10;else:&amp;#10;    conditions_file = &quot;ifst_files/conditions_right.xlsx&quot;" valType="extendedCode" updates="constant" name="End Routine"/>
