        <Param val="inst_msg = &quot;&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;handedness&quot;, handedness);&amp;#10;if ((hand === handedness)) {&amp;#10;    continueRoutine = true;&amp;#10;} else {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;psychoJS.window.mouseVisible = false;&amp;#10;try {&amp;#10;    inst_msg = eval(`inst_msg_${lang_code}`);&amp;#10;} catch(e) {&amp;#10;    if ((e instanceof ReferenceError)) {&amp;#10;        inst_msg = inst_msg_EN;&amp;#10;    } else {&amp;#10;        throw e;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="thisExp.addData(&quot;handedness&quot;, handedness)&amp;#10;if hand == handedness:&amp;#10;    continueRoutine = True&amp;#10;else:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;# hide mouse for the rest of the experiment&amp;#10;win.mouseVisible = False&amp;#10;# get column from excel sheet based on language code&amp;#10;try:&amp;#10;    inst_msg = eval(f&quot;inst_msg_{lang_code}&quot;)&amp;#10;# default to english if this fails&amp;#10;except ReferenceError:&amp;#10;    inst_msg = inst_msg_EN&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
