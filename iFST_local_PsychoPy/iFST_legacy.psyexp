      <CodeComponent name="block_settings_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((block_number &lt;= practice_blocks)) {&amp;#10;    feedback = true;&amp;#10;    reps_per_block = 999;&amp;#10;    self_assess_show = 0;&amp;#10;    sequence = sequence;&amp;#10;} else {&amp;#10;    if ((block_number === (practice_blocks + 1))) {&amp;#10;        feedback = false;&amp;#10;        reps_per_block = n_reps;&amp;#10;        self_assess_show = 1;&amp;#10;        if ((group === 0)) {&amp;#10;            sequence = &quot;simple&quot;;&amp;#10;        } else {&amp;#10;            if ((group === 1)) {&amp;#10;                sequence = &quot;complex&quot;;&amp;#10;            }&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((block_number === (practice_blocks + 2))) {&amp;#10;            feedback = false;&amp;#10;            reps_per_block = n_reps;&amp;#10;            self_assess_show = 1;&amp;#10;            if ((group === 0)) {&amp;#10;                sequence = &quot;complex&quot;;&amp;#10;            } else {&amp;#10;                if ((group === 1)) {&amp;#10;                    sequence = &quot;simple&quot;;&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;reps_per_block&quot;, reps_per_block);&amp;#10;psychoJS.experiment.addData(&quot;sequence_selected&quot;, sequence);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# change conditions based on block&amp;#10;if block_number &lt;= practice_blocks:&amp;#10;    feedback = True&amp;#10;    reps_per_block = 999&amp;#10;    self_assess_show = 0&amp;#10;    sequence = sequence&amp;#10;elif block_number == practice_blocks + 1:&amp;#10;    feedback = False&amp;#10;    reps_per_block = n_reps&amp;#10;    self_assess_show = 1&amp;#10;    if group == 0:&amp;#10;        sequence = &quot;simple&quot;&amp;#10;    elif group == 1:&amp;#10;        sequence = &quot;complex&quot;&amp;#10;elif block_number == practice_blocks + 2:&amp;#10;    feedback = False&amp;#10;    reps_per_block = n_reps&amp;#10;    self_assess_show = 1&amp;#10;    if group == 0:&amp;#10;        sequence = &quot;complex&quot;&amp;#10;    elif group == 1:&amp;#10;        sequence = &quot;simple&quot;&amp;#10;thisExp.addData(&quot;reps_per_block&quot;, reps_per_block)&amp;#10;thisExp.addData(&quot;sequence_selected&quot;, sequence)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="block_settings_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
